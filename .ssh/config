#   C:\ProgramData\ssh\administrators_authorized_keys
Host henry-laptop
    HostName 100.97.54.0
    User henry
    IdentityFile ~/.ssh/henry5720

Host henry-desktop
    HostName 100.119.136.27
    User henry
    IdentityFile ~/.ssh/henry5720

Host nettop
    HostName 100.111.240.34
    User henry
    IdentityFile ~/.ssh/henry5720

# ===============================================================
# 3. Android (只有 Termux sshd)
# ===============================================================
# 原生 Android 沒有 sshd,需要 Termux + openssh 且 sshd 有在跑。
# Termux 聽 8022(非 root 綁不了 22);User 是 Termux 配給的 u0_aXXX。
Host pad
    HostName 100.102.9.79
    User u0_a301
    Port 8022
    IdentityFile ~/.ssh/henry5720

# LocalForward 左邊在「本機」開 port,右邊的 localhost 在「phone 上」解析,
# 也就是把 phone 的服務搬到本機 http://localhost:<port>。
# server 必須綁 127.0.0.1 才連得到。
# 連線中要臨時加 port:換行後按 ~C ,輸入  -L 5173:localhost:5173
Host phone
    HostName 100.94.24.13
    User u0_a358
    Port 8022
    IdentityFile ~/.ssh/henry5720
    LocalForward 8080 localhost:8080
    LocalForward 3000 localhost:3000
    LocalForward 3001 localhost:3001
    LocalForward 3002 localhost:3002
    ServerAliveInterval 30
    ServerAliveCountMax 3

# ===============================================================
# 4. Oracle VPS (非 Tailscale)
# ===============================================================
# 有兩個不同的 Oracle 帳號(tenancy),各自有一份獨立的 Always Free 額度。
# Host 名一律用 OCI Console 上的 display name,免得再搞混。
#
#   tenancy A  ...z3lry3...  ← 我的。instance-1、instance-2
#   tenancy B  ...7yh5zf...  ← 別人的。hermes、openab
#
# 判斷某台屬於哪個帳號,登進去跑:
#   curl -sH "Authorization: Bearer Oracle" \
#     http://169.254.169.254/opc/v2/instance/ | jq -r .compartmentId

# ── tenancy A(我的)────────────────────────────────
# E2.1.Micro 1 OCPU / 1 GB。Always Free 的 micro 上限就是 2 台,已用滿。
# A1 額度(2 OCPU / 12 GB)在這個帳號還全空。

# 搶 A1 的 cron 跑在這台(~/oracle-toolkit,每 10 分鐘一次,log 在 ~/grab-a1.log)。
# openclaw gateway 已停用(systemctl --user disable --now openclaw-gateway),
# 要復原就 enable --now。nginx(:80/:443)還開著,但後端已經沒在跑。
Host instance-1
    HostName 132.145.162.28
    User ubuntu
    IdentityFile ~/.ssh/henry5720

# 閒置。原本要拿來搶 A1,後來改跑在 instance-1,這台的 ~/.oci 與 ~/oracle-toolkit
# 已移除。留著是因為關掉也不會多出 A1 額度,只會多 47 GB 硬碟。
Host instance-2
    HostName 150.136.80.76
    User ubuntu
    IdentityFile ~/.ssh/henry5720

# ── tenancy B(別人的,不要動)──────────────────────
# 兩台 A1 各 1 OCPU / 6 GB,把 B 的 A1 額度佔滿了(2/2 OCPU、12/12 GB)。

# a1-fleet-1,跑 hermes gateway + ollama + nginx
Host hermes
    HostName 150.136.179.96
    User henry
    IdentityFile ~/.ssh/henry5720
    IdentitiesOnly yes

# a1-fleet-2,跑 openab-codex / openab-patrick / openab-claude 三個 container
# User 是 ubuntu 不是 henry,原本寫 henry 一直 Permission denied
Host openab
    HostName 158.101.108.0
    User ubuntu
    IdentityFile ~/.ssh/henry5720
    IdentitiesOnly yes

