# ── Android (Termux sshd only) ─────────────────────
# stock Android has no sshd. requires Termux + openssh + sshd running.
# Termux listens on 8022 (non-root can't bind 22); User is arbitrary.
# uncomment + fix User once Termux sshd is up.
Host pad
    HostName 100.102.9.79
    User u0_a301
    Port 8022
    IdentityFile ~/.ssh/henry5720
# Forward dev ports so pad's browser sees http://localhost:<port>
# (code-server webviews need a localhost/https secure context).
# RHS resolves ON phone → keep it localhost. Servers must bind 127.0.0.1.
# Add a port mid-session: newline, then ~C , then  -L 5173:localhost:5173
Host phone
    HostName 100.94.24.13
    User u0_a358
    Port 8022
    IdentityFile ~/.ssh/henry5720
    LocalForward 8080 localhost:8080
    LocalForward 3000 localhost:3000
    LocalForward 3001 localhost:3001
    LocalForward 3002 localhost:3002
    ServerAliveInterval 30
    ServerAliveCountMax 3

