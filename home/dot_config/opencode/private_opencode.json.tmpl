{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "codex-lb-gcp": {
      "npm": "@ai-sdk/openai",
      "name": "TeamSync codex-lb (GCP)",
      "options": {
        "baseURL": "https://codex.teamsync.com.tw/backend-api/codex",
        "apiKey": "{{ .codexLbApiKey }}"
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol (TeamSync)",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "limit": {
            "context": 272000,
            "output": 128000
          }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra (TeamSync)",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "limit": {
            "context": 272000,
            "output": 128000
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna (TeamSync)",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "limit": {
            "context": 272000,
            "output": 128000
          }
        },
        "gpt-5.5": {
          "name": "GPT-5.5 (TeamSync)",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "limit": {
            "context": 272000,
            "output": 128000
          }
        },
        "gpt-5.4": {
          "name": "GPT-5.4 (TeamSync)",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "limit": {
            "context": 272000,
            "output": 128000
          }
        },
        "gpt-5.4-mini": {
          "name": "GPT-5.4 Mini (TeamSync)",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "limit": {
            "context": 272000,
            "output": 128000
          }
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "sequential-thinking": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "chrome-devtools": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--browser-url=http://127.0.0.1:9222",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    }
  },
  "plugin": [
    "opencode-wakatime"
  ]
}
