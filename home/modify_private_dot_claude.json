#!/bin/sh
# ~/.claude.json 有 2200 行,99% 是 Claude Code 自己寫的狀態(開過哪些專案的絕對路徑、
# 帳號 email、feature flag 快取)。這個 repo 是公開的,整份納管等於把那些推上 GitHub,
# 所以用 chezmoi 的 modify_:現有檔案從 stdin 進來,只改 mcpServers 底下那一段,其他原封不動。
#
# 為什麼這段設定值得納管,而 context7 / promptx 不值得 ——
# 官方裝法是 `claude mcp add chrome-devtools npx chrome-devtools-mcp@latest`,
# 那行生出來的設定沒有 --browser-url,會想在 WSL 自己開一個 Chrome 然後失敗
# (Protocol error (Target.setDiscoverTargets): Target closed)。
# 下面這四個參數是重跑 installer 不會回來的東西。細節見 docs/chrome-devtools-mcp.md。

set -eu

# 1. 吃現有內容;檔案不存在時(新機器)stdin 是空的,墊一個空物件給 jq。
existing=$(cat)
[ -n "$existing" ] || existing='{}'

# 2. 只覆寫 mcpServers["chrome-devtools"] 這一個 key。
#    外層 printf '%s' "$(...)" 是為了砍掉 jq 補的結尾換行 —— Claude Code 寫出來的檔案
#    結尾沒有 newline,不砍的話每次 chezmoi diff 都會多一行雜訊。
printf '%s' "$(printf '%s' "$existing" | jq '
  .mcpServers["chrome-devtools"] = {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "chrome-devtools-mcp@latest",
      "--browser-url=http://127.0.0.1:9222",
      "--no-usage-statistics",
      "--no-performance-crux"
    ],
    "env": {}
  }
')"
